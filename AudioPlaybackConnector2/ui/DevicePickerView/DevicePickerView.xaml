<?xml version="1.0" encoding="utf-8"?>
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Class="AudioPlaybackConnector2.DevicePickerView"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" MinWidth="260" MaxWidth="520">
        <Grid.Resources>
            <x:Double x:Key="ToggleSwitchPreContentMargin">6</x:Double>
            <x:Double x:Key="ToggleSwitchPostContentMargin">6</x:Double>
        </Grid.Resources>
        <StackPanel x:Name="ContentPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Margin="2"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Column="1"
                    Margin="5"
                    Padding="5"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <ProgressRing
                    x:Name="HeaderRefreshIndicator"
                    Grid.Column="2"
                    Width="14"
                    Height="14"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="3"
                    Margin="2"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="15" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="4"
                    Margin="5"
                    Padding="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="15" Glyph="&#xE711;" />
                </Button>
            </Grid>
            <StackPanel x:Name="DeviceListPanel">
                <Grid x:Name="GlobalActionsPanel" Margin="5,0,5,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="DisconnectAllButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE711;" />
                            <TextBlock
                                x:Name="DisconnectAllText"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ReconnectAllButton"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE72C;" />
                            <TextBlock
                                x:Name="ReconnectAllText"
                                FontSize="12"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ProgressRing
                    x:Name="ProgressIndicator"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <ListView x:Name="DeviceList" MaxHeight="480" Margin="5" SelectionMode="None" />
                <Button
                    x:Name="SavedDevicesButton"
                    Margin="5,0,5,4"
                    Padding="8,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <FontIcon x:Name="SavedDevicesChevron" FontSize="12" Glyph="&#xE70D;" />
                        <TextBlock x:Name="SavedDevicesText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                </Button>
            </StackPanel>
            <ScrollViewer
                x:Name="DeviceOptionsPanel"
                MaxHeight="480"
                Margin="10,4,10,10"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <InfoBar x:Name="DeviceOptionsError" IsOpen="False" Severity="Error" IsClosable="True" />
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                x:Name="DeviceAliasLabel"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="ForgetDeviceButton"
                                HorizontalAlignment="Right"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Grid.Column="1"
                                MinHeight="28">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBox x:Name="DeviceAliasBox" MinWidth="0" />
                            <Button
                                x:Name="ClearAliasButton"
                                Grid.Column="1"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                        <TextBlock x:Name="DefaultDeviceText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="DefaultDeviceToggle"
                            Grid.Column="1"
                            MinWidth="44"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                        <TextBlock x:Name="DeviceStartupText" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="DeviceStartupToggle"
                            Grid.Column="1"
                            MinWidth="44"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32">
                        <TextBlock
                            x:Name="DeviceReconnectText"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            x:Name="DeviceReconnectToggle"
                            Grid.Column="1"
                            MinWidth="44"
                            VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
