<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Target Name="ResolveBuildVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\release\resolve-build-version.ps1&quot; -RepositoryPath &quot;$(MSBuildThisFileDirectory).&quot;"
          EnvironmentVariables="APC_BUILD_RELEASE_TAG=$(ReleaseTag);APC_BUILD_PACKAGE_VERSION=$(PackageVersion)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" LogStandardErrorAsError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ApcResolvedPackageVersion" />
    </Exec>
    <PropertyGroup>
      <PackageVersion>$(_ApcResolvedPackageVersion)</PackageVersion>
    </PropertyGroup>
  </Target>
  <Target Name="ValidateCppToolchain" BeforeTargets="PrepareForBuild"
          Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <Error Condition="'$(PlatformToolset)' != 'v145'" Text="AudioPlaybackConnector2 requires the v145 toolset." />
    <Error Condition="'$(VCToolsVersion)' == ''" Text="The MSVC toolchain version was not resolved." />
    <Error Condition="'$(VCToolsVersion)' != '' and $([MSBuild]::VersionLessThan('$(VCToolsVersion)', '14.51'))"
           Text="AudioPlaybackConnector2 requires MSVC 14.51 or newer; found $(VCToolsVersion)." />
    <Error Condition="'%(ClCompile.LanguageStandard)' != 'stdcpplatest'"
           Text="All C++ translation units must use the C++26 draft mode (stdcpplatest)." />
    <Message Importance="high" Text="Toolchain: $(PlatformToolset), MSVC $(VCToolsVersion), C++26 draft, $(Platform)." />
  </Target>
  <Target Name="DisablePrecompiledHeaders" BeforeTargets="ClCompile"
          Condition="'$(ApcDisablePrecompiledHeaders)' == 'true'">
    <ItemGroup>
      <ClCompile>
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <PreprocessorDefinitions>APC_NO_PCH_INCLUDES;%(ClCompile.PreprocessorDefinitions)</PreprocessorDefinitions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
