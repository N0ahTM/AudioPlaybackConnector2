<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Class="AudioPlaybackConnector2.SettingsWindow"
    Title=""
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <x:Double x:Key="ToggleSwitchPreContentMargin">6</x:Double>
            <x:Double x:Key="ToggleSwitchPostContentMargin">6</x:Double>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="AudioPlaybackConnector2" />
        </Grid>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,12,0" MinHeight="36">
                <Button
                    x:Name="SettingsBackButton"
                    Click="SettingsBackButton_Click"
                    Visibility="Collapsed"
                    Padding="8"
                    MinWidth="32"
                    MinHeight="32"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock
                    x:Name="SettingsPageTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="SettingsHelpButton"
                    Grid.Column="2"
                    Click="SettingsHelpButton_Click"
                    Padding="10,4"
                    MinWidth="32"
                    MinHeight="32"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE897;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="SettingsHelpText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer
                x:Name="SettingsContentHost"
                Padding="12,4,12,12"
                HorizontalScrollBarVisibility="Disabled"
                SizeChanged="SettingsContentHost_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                Grid.Row="1">
                <StackPanel x:Name="SettingsContentPanel" HorizontalAlignment="Center" Spacing="8">
                    <InfoBar
                        x:Name="DiagnosticsInfoBar"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Stretch"
                        IsClosable="True"
                        IsOpen="False" />
                    <StackPanel
                        x:Name="AppSection"
                        HorizontalAlignment="Stretch"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <StackPanel Margin="0" Spacing="4" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LanguageLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="LanguageComboBox"
                                    Grid.Column="1"
                                    MinWidth="190"
                                    SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem x:Name="LanguageSystemItem" Content="" Tag="system" />
                                    <ComboBoxItem x:Name="LanguageEnglishItem" Content="" Tag="en" />
                                    <ComboBoxItem x:Name="LanguageGermanItem" Content="" Tag="de" />
                                    <ComboBoxItem x:Name="LanguageFrenchItem" Content="" Tag="fr" />
                                    <ComboBoxItem x:Name="LanguageSpanishItem" Content="" Tag="es" />
                                    <ComboBoxItem x:Name="LanguageJapaneseItem" Content="" Tag="ja" />
                                    <ComboBoxItem x:Name="LanguageKoreanItem" Content="" Tag="ko" />
                                    <ComboBoxItem
                                        x:Name="LanguageChineseSimplifiedItem"
                                        Content=""
                                        Tag="zh_hans" />
                                    <ComboBoxItem
                                        x:Name="LanguageChineseTraditionalItem"
                                        Content=""
                                        Tag="zh_hant" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartWithWindowsLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <ProgressRing
                                        x:Name="StartupTaskProgress"
                                        Width="20"
                                        Height="20"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <ToggleSwitch
                                        x:Name="StartWithWindowsToggle"
                                        MinWidth="64"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ShowNotificationsLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ShowNotificationsToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="SystemBackdropEffectsLabel"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="SystemBackdropEffectsToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WindowPlacementLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="ResetWindowPlacementButton"
                                    Grid.Column="1"
                                    Click="ResetWindowPlacementButton_Click"
                                    Width="64"
                                    MinHeight="32"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="0,0,24,0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="ConnectionGroupText"
                                Margin="0,12,0,4"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConnectOnStartupLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ConnectOnStartupToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="ReconnectOnConnectionLossLabel"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="ReconnectOnConnectionLossToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="32" Margin="0">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="AllowIncomingConnectionsLabel"
                                        Text=""
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AllowIncomingConnectionsToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                            <Grid
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                MinHeight="32">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PrivacyModeLabel" Text="" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="PrivacyModeToggle"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="64" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="HelpSection" Spacing="8" Visibility="Collapsed">
                        <Button
                            x:Name="ReportBugButton"
                            HorizontalAlignment="Stretch"
                            Click="ReportBugButton_Click"
                            HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8BD;" />
                                <TextBlock
                                    x:Name="ReportBugButtonText"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    TextWrapping="WrapWholeWords"
                                    Text="" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="TroubleshootingButton"
                            HorizontalAlignment="Stretch"
                            Click="TroubleshootingButton_Click"
                            HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE946;" />
                                <TextBlock
                                    x:Name="TroubleshootingButtonText"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    TextWrapping="WrapWholeWords"
                                    Text="" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="OpenBluetoothSettingsButton"
                            HorizontalAlignment="Stretch"
                            Click="OpenBluetoothSettingsButton_Click"
                            HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE702;" />
                                <TextBlock
                                    x:Name="OpenBluetoothSettingsButtonText"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    TextWrapping="WrapWholeWords"
                                    Text="" />
                            </Grid>
                        </Button>
                        <Expander
                            x:Name="DiagnosticsExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="DiagnosticsPrivacyText"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                    Text=""
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="CopyDiagnosticsButton"
                                    HorizontalAlignment="Stretch"
                                    Click="CopyDiagnosticsButton_Click"
                                    HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock
                                            x:Name="CopyDiagnosticsButtonText"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            TextWrapping="WrapWholeWords"
                                            Text="" />
                                    </Grid>
                                </Button>
                                <Button
                                    x:Name="OpenLogFolderButton"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenLogFolderButton_Click"
                                    HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8B7;" />
                                        <TextBlock
                                            x:Name="OpenLogFolderButtonText"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            TextWrapping="WrapWholeWords"
                                            Text="" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Expander>
                        <Button
                            x:Name="FeatureRequestButton"
                            HorizontalAlignment="Stretch"
                            Click="FeatureRequestButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE710;" />
                                <TextBlock
                                    x:Name="FeatureRequestButtonText"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    TextWrapping="WrapWholeWords"
                                    Text="" />
                            </Grid>
                        </Button>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <TextBlock
                                x:Name="VersionText"
                                Text=""
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <ProgressRing
                                    x:Name="UpdateCheckProgress"
                                    Width="20"
                                    Height="20"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="CheckForUpdatesButton"
                                    Click="CheckForUpdatesButton_Click"
                                    Grid.Column="1"
                                    MinWidth="32"
                                    MinHeight="32"
                                    Padding="8">
                                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                        </Grid>
                        <InfoBar
                            x:Name="UpdateInfoBar"
                            HorizontalAlignment="Stretch"
                            IsClosable="True"
                            IsOpen="False">
                            <InfoBar.ActionButton>
                                <Button
                                    x:Name="OpenAppInstallerButton"
                                    Click="OpenAppInstallerButton_Click"
                                    Visibility="Collapsed">
                                    <Button.Content>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xE8A7;" />
                                            <TextBlock
                                                x:Name="OpenAppInstallerButtonText"
                                                Grid.Column="1"
                                                MinWidth="0"
                                                TextWrapping="WrapWholeWords"
                                                Text="" />
                                        </Grid>
                                    </Button.Content>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock
                                x:Name="CopyrightText"
                                Margin="0"
                                FontSize="12"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text=""
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="RepositoryButton"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="RepositoryButton_Click"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="&#xE8A7;" />
                                    <TextBlock
                                        x:Name="RepositoryButtonText"
                                        Grid.Column="1"
                                        MinWidth="0"
                                        TextWrapping="WrapWholeWords"
                                        Text="" />
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
